# ---------------------------------------------------------------------------
# Single-VPS production config for docker-compose.yml. Copy to .env on the VPS and fill in.
# Generate secrets with:  openssl rand -hex 32
# ---------------------------------------------------------------------------

# Domains (point their DNS A record to the VPS IP). Tenant website domains are added later in the admin panel.
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com

POSTGRES_PASSWORD=
JWT_SECRET=
REVALIDATE_SECRET=

# First super admin (created on first start)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

MAX_AUDIO_UPLOAD_MB=500
WORKER_CONCURRENCY=2

# Public tenant site URLs (RSS links, canonical, sitemaps). Only change when sites are served without TLS
# or on a non-standard port, e.g. PUBLIC_SITE_SCHEME=http PUBLIC_SITE_PORT=8090
PUBLIC_SITE_SCHEME=https
PUBLIC_SITE_PORT=

# Expected DNS target for tenant domains (shown in the admin domain check): the VPS public IP
PLATFORM_IPS=
PLATFORM_CNAME_TARGET=

# Optional integrations
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
