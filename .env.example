# ---------------------------------------------------------------------------
# Podcast Platform Engine — environment (PRD §100). Copy to .env and fill in.
# Secrets must never be committed.
# ---------------------------------------------------------------------------
APP_ENV=development
PORT=8080

DATABASE_URL=postgres://postgres:postgres@localhost:5432/podcast?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Object storage: "local" (development) or "s3" (Cloudflare R2, AWS S3, Backblaze B2, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
S3_ENDPOINT=
S3_BUCKET=podcast
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PATH_STYLE=true
# Public CDN base URL for audio & images (in production audio never streams through the app server)
CDN_URL=http://localhost:8080/media

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_SECURE=false

APP_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:8080
WEB_INTERNAL_URL=http://localhost:3000
REVALIDATE_SECRET=change-me-too
CORS_ORIGINS=http://localhost:3001

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_AUDIO_UPLOAD_MB=500
MAX_IMAGE_UPLOAD_MB=10

# Allow fetching RSS feeds / webhooks on private networks (development only)
ALLOW_PRIVATE_FETCH=false
# *.localhost / *.test domains are auto-verified in development
DEV_AUTO_VERIFY_LOCAL_DOMAINS=true
# Public tenant site URLs (RSS links, canonical, sitemaps). Only change when sites are served without TLS
# or on a non-standard port, e.g. PUBLIC_SITE_SCHEME=http PUBLIC_SITE_PORT=8090
PUBLIC_SITE_SCHEME=https
PUBLIC_SITE_PORT=

# Expected DNS target for tenant domains (used by the domain DNS check)
PLATFORM_CNAME_TARGET=
PLATFORM_IPS=

# Optional integrations
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# First super admin (created on first start; required in production)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

WORKER_CONCURRENCY=4
LOG_LEVEL=info

# Web / admin (Next.js)
API_INTERNAL_URL=http://localhost:8080
